# Copy to .env and fill in. .env is never committed.

# Where Tailscale Serve connects from: the address of the machine running
# `tailscale serve` as seen by fruit-fs. Requests from here may carry a
# Tailscale-User-Login header; from anywhere else that header is ignored.
FRUITFS_TRUSTED_PROXIES=192.0.2.10

# Optional: only these tailnet logins may use fruit-fs (comma separated).
# Leave empty to allow everyone on the tailnet.
FRUITFS_ALLOWED_USERS=

# Optional: only these tailnet logins may open the Admin page (comma separated).
# Leave empty to let every tailnet user change guest settings.
FRUITFS_ADMINS=

# Password for access on the local network, as an argon2id hash:
#   docker run --rm -i ghcr.io/zelder-bit/fruit-fs hash-password
# Keep the single quotes: the hash contains $ signs that compose would
# otherwise treat as variables. Leave empty to allow Tailscale only.
FRUITFS_PASSWORD_HASH=''


# Largest single upload, e.g. 20G. Empty = no limit.
FRUITFS_MAX_UPLOAD=

# Port to listen on (all interfaces).
FRUITFS_LISTEN=:8080

# Host folders mounted into the container (used by compose.yaml).
# Both must be writable by uid 65532.
FRUITFS_DATA_DIR=./data
FRUITFS_STATE_DIR=./state
